          "stringUnit": {
            "state": "translated",
            "value": "Sulla TV mancano le credenziali di questo server. Ripeti l’abbinamento da iPhone, iPad o Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan las credenciales de este servidor en el TV. Vuelve a emparejarlo desde tu iPhone, iPad o Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants de ce serveur manquent sur la TV. Refaites le jumelage depuis votre iPhone, iPad ou Mac."
