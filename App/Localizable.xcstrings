          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumeler une Apple TV"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV koppeln"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对 Apple TV"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إقران Apple TV"
          }
        }
      }
    },
    "On the Apple TV open Unraid Drive: it shows a 6-digit code. Enter it here and choose the server to send. The credentials travel encrypted with the code; the TV connects through your unraid-gateway with your own permissions.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulla Apple TV apri Unraid Drive: mostra un codice di 6 cifre. Inseriscilo qui e scegli il server da inviare. Le credenziali viaggiano cifrate con il codice; la TV si collega tramite il tuo unraid-gateway con i tuoi permessi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el Apple TV abre Unraid Drive: muestra un código de 6 cifras. Introdúcelo aquí y elige el servidor a enviar. Las credenciales viajan cifradas con el código; el TV se conecta a través de tu unraid-gateway con tus permisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’Apple TV, ouvrez Unraid Drive : elle affiche un code à 6 chiffres. Saisissez-le ici et choisissez le serveur à envoyer. Les identifiants voyagent chiffrés avec le code ; la TV se connecte via votre unraid-gateway avec vos permissions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne auf dem Apple TV Unraid Drive: Es zeigt einen 6-stelligen Code. Gib ihn hier ein und wähle den zu sendenden Server. Die Zugangsdaten reisen mit dem Code verschlüsselt; der TV verbindet sich über dein unraid-gateway mit deinen Berechtigungen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple TV 上打开 Unraid Drive：它会显示一个 6 位代码。在此输入并选择要发送的服务器。凭据以该代码加密传输；Apple TV 通过你的 unraid-gateway 以你的权限连接。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على Apple TV افتح Unraid Drive: سيعرض رمزًا من 6 أرقام. أدخله هنا واختر الخادم المطلوب إرساله. تنتقل بيانات الاعتماد مشفّرة بالرمز؛ ويتصل التلفاز عبر unraid-gateway بصلاحياتك."
          }
        }
      }
    },
    "Code shown on the TV": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codice mostrato sulla TV"
          }
        },
        "es": {
