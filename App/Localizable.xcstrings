          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud está activada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud est activée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Synchronisierung ist eingeschaltet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步已开启。"
          }
        },
        "ar": {
