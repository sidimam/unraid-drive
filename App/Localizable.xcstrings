    "Add a server first: you will choose its shares right after connecting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف خادمًا أولًا: ستختار مشاركاته مباشرة بعد الاتصال."
          }
        },
        "de": {
          "stringUnit": {
