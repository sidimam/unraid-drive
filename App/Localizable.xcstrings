    "Authenticated, but no shares are mounted in the container. Add Path mappings under /data/<name> in the container settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت المصادقة، لكن لا توجد مجلدات مشتركة مثبّتة في الحاوية. أضف مسارات تحت /data/<الاسم> في إعدادات الحاوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldet, aber im Container sind keine Freigaben eingebunden. Füge in den Container-Einstellungen Pfade unter /data/<Name> hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticado, pero no hay recursos compartidos montados en el contenedor. Añade rutas bajo /data/<nombre> en la configuración del contenedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifié, mais aucun partage n’est monté dans le conteneur. Ajoutez des chemins sous /data/<nom> dans les réglages du conteneur."
          }
        },
        "it": {
