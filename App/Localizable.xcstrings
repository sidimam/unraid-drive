    "Add your Unraid server through its unraid-gateway URL and an Unraid API key. Its shares will appear in the Files app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف خادم Unraid عبر عنوان unraid-gateway ومفتاح API الخاص بـ Unraid. ستظهر مجلداته المشتركة في تطبيق الملفات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinen Unraid-Server über die unraid-gateway-URL und einen Unraid-API-Schlüssel hinzu. Seine Freigaben erscheinen in der Dateien-App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu servidor Unraid con la URL de unraid-gateway y una clave API de Unraid. Sus recursos compartidos aparecerán en la app Archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre serveur Unraid avec l’URL d’unraid-gateway et une clé API Unraid. Ses partages apparaîtront dans l’app Fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il tuo server Unraid con l’URL di unraid-gateway e una chiave API Unraid. Le sue share compariranno nell’app File."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 unraid-gateway 的 URL 和 Unraid API 密钥添加你的 Unraid 服务器。其共享文件夹将显示在“文件”应用中。"
          }
        }
      }
    },
