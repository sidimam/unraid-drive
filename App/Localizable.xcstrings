    "No shares mounted in the container": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مجلدات مشتركة مثبّتة في الحاوية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Freigaben im Container eingebunden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay recursos compartidos montados en el contenedor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun partage monté dans le conteneur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna share montata nel container"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器中未挂载任何共享"
          }
        }
      }
    },
    "No unraid-gateway container found in Docker.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على حاوية unraid-gateway في Docker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein unraid-gateway-Container in Docker gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún contenedor unraid-gateway en Docker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun conteneur unraid-gateway trouvé dans Docker."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun container unraid-gateway trovato in Docker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Docker 中未找到 unraid-gateway 容器。"
          }
        }
      }
    },
    "On Unraid, add the unraid-gateway container from the template URL in the project README. Map the shares you want on your phone under /data/<name>. Nothing else runs on the server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على Unraid أضف حاوية unraid-gateway من عنوان القالب الموجود في README المشروع. اربط المجلدات التي تريدها على هاتفك تحت /data/<الاسم>. لا يعمل شيء آخر على الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge auf Unraid den unraid-gateway-Container über die Template-URL aus der README des Projekts hinzu. Binde die gewünschten Freigaben unter /data/<Name> ein. Sonst läuft nichts auf dem Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Unraid añade el contenedor unraid-gateway desde la URL de plantilla del README del proyecto. Mapea los recursos que quieras en el teléfono bajo /data/<nombre>. Nada más se ejecuta en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur Unraid, ajoutez le conteneur unraid-gateway depuis l’URL de modèle du README du projet. Mappez les partages voulus sur le téléphone sous /data/<nom>. Rien d’autre ne tourne sur le serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su Unraid aggiungi il container unraid-gateway dall’URL del template nel README del progetto. Mappa le share che vuoi sul telefono sotto /data/<nome>. Sul server non gira nient’altro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Unraid 上，通过项目 README 中的模板 URL 添加 unraid-gateway 容器。把想在手机上使用的共享映射到 /data/<名称>。服务器上不需要运行其他任何东西。"
          }
        }
      }
    },
