          }
        }
      }
    },
    "Files you open are kept on disk so they open instantly next time; the system removes them when space runs low. Free the space now if you prefer.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file che apri restano sul disco per aprirsi subito la prossima volta; il sistema li rimuove quando lo spazio scarseggia. Se preferisci, libera lo spazio ora."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos que abres se guardan en el disco para abrirse al instante la próxima vez; el sistema los elimina cuando queda poco espacio. Si lo prefieres, libera el espacio ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers que vous ouvrez restent sur le disque pour s’ouvrir instantanément la prochaine fois ; le système les supprime quand l’espace manque. Libérez l’espace maintenant si vous préférez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geöffnete Dateien bleiben auf der Festplatte, damit sie beim nächsten Mal sofort öffnen; das System entfernt sie, wenn der Platz knapp wird. Gib den Platz jetzt frei, wenn du möchtest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打开的文件会保留在磁盘上，以便下次立即打开；空间不足时系统会自动移除。你也可以现在释放空间。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الملفات التي تفتحها على القرص لتُفتح فورًا في المرة القادمة؛ ويزيلها النظام عند نقص المساحة. حرّر المساحة الآن إن أردت."
          }
        }
      }
    },
