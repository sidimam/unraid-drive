    "No server yet? The demo adds sample shares that work offline, in this app and in the Files app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد خادم بعد؟ يضيف العرض التجريبي مجلدات نموذجية تعمل دون اتصال، في هذا التطبيق وفي تطبيق الملفات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Server? Die Demo fügt Beispielfreigaben hinzu, die offline funktionieren, in dieser App und in Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Aún sin servidor? La demo añade recursos compartidos de ejemplo que funcionan sin conexión, en esta app y en Archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de serveur ? La démo ajoute des partages d’exemple qui fonctionnent hors ligne, dans cette app et dans Fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun server? La demo aggiunge share di esempio che funzionano offline, in questa app e nell’app File."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有服务器？演示会添加可离线使用的示例共享，在本应用和“文件”应用中均可使用。"
          }
        }
      }
    },
    "No servers": {
      "localizations": {
        "ar": {
