          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩包"
          }
        }
      }
    },
    "Array": {},
    "Asks the Files app / Finder to re-read every Unraid Drive location from the gateway.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب من تطبيق الملفات / Finder إعادة قراءة كل موقع Unraid Drive من البوابة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt die Dateien-App / den Finder jeden Unraid Drive-Ort neu vom Gateway lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a la app Archivos / al Finder que vuelva a leer cada ubicación de Unraid Drive desde el gateway."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à l’app Fichiers / au Finder de relire chaque emplacement Unraid Drive depuis la passerelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede all’app File / al Finder di rileggere ogni posizione di Unraid Drive dal gateway."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让“文件”应用/“访达”从网关重新读取每个 Unraid Drive 位置。"
          }
        }
      }
    },
    "Asks the Finder to re-read every location from the gateway and reloads status, activity and notifications.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب من Finder إعادة قراءة كل موقع من البوابة ويعيد تحميل الحالة والنشاط والإشعارات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt den Finder jeden Ort neu vom Gateway lesen und lädt Status, Aktivität und Mitteilungen neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide al Finder que vuelva a leer cada ubicación desde el gateway y recarga estado, actividad y notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande au Finder de relire chaque emplacement depuis la passerelle et recharge l’état, l’activité et les notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede al Finder di rileggere ogni posizione dal gateway e ricarica stato, attività e notifiche."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让“访达”从网关重新读取每个位置，并重新加载状态、活动和通知。"
          }
        }
      }
    },
    "Audio": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوت"
          }
        },
        "de": {
