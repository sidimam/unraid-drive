    },
    "This EPUB has no readable text chapters.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الـ EPUB على فصول نصية قابلة للقراءة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses EPUB enthält keine lesbaren Textkapitel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este EPUB no tiene capítulos de texto legibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet EPUB n’a aucun chapitre de texte lisible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo EPUB non ha capitoli di testo leggibili."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 EPUB 没有可读的文本章节。"
          }
        }
      }
    },
    "This format needs the mpv player, which runs on iPhone, iPad, Mac and Apple TV. Use Quick Look or open the file from the Files app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج هذا التنسيق إلى مشغّل mpv المتاح على iPhone وiPad وMac وApple TV. استخدم النظرة السريعة أو افتح الملف من تطبيق الملفات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Format braucht den mpv-Player, der auf iPhone, iPad, Mac und Apple TV läuft. Nutze die Übersicht oder öffne die Datei aus der Dateien-App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato necesita el reproductor mpv, disponible en iPhone, iPad, Mac y Apple TV. Usa Vista rápida o abre el archivo desde la app Archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format nécessite le lecteur mpv, disponible sur iPhone, iPad, Mac et Apple TV. Utilisez Coup d’œil ou ouvrez le fichier depuis l’app Fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo formato richiede il lettore mpv, disponibile su iPhone, iPad, Mac e Apple TV. Usa Quick Look o apri il file dall’app File."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此格式需要 mpv 播放器，可在 iPhone、iPad、Mac 和 Apple TV 上使用。请使用快速查看或从“文件”应用打开。"
          }
        }
      }
    },
    "This needs unraid-gateway 0.6 or later on the server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب unraid-gateway 0.6 أو أحدث على الخادم."
          }
        },
        "de": {
          "stringUnit": {
