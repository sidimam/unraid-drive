    "unraid-gateway did not answer: %@. Files already downloaded stay available; changes will sync when the server is back.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "unraid-gateway non ha risposto: %@. I file già scaricati restano disponibili; le modifiche si sincronizzeranno quando il server tornerà raggiungibile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "unraid-gateway no respondió: %@. Los archivos ya descargados siguen disponibles; los cambios se sincronizarán cuando el servidor vuelva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "unraid-gateway n’a pas répondu : %@. Les fichiers déjà téléchargés restent disponibles ; les modifications se synchroniseront au retour du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "unraid-gateway hat nicht geantwortet: %@. Bereits geladene Dateien bleiben verfügbar; Änderungen werden synchronisiert, sobald der Server zurück ist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "unraid-gateway 未响应：%@。已下载的文件仍可使用；服务器恢复后会同步更改。"
