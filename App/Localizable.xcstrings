    "Received data could not be decrypted. Check the code and try again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati ricevuti non si possono decifrare. Controlla il codice e riprova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron descifrar los datos recibidos. Comprueba el código y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données reçues n’ont pu être déchiffrées. Vérifiez le code et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die empfangenen Daten konnten nicht entschlüsselt werden. Prüfe den Code und versuche es erneut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解密收到的数据。请检查代码后重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فك تشفير البيانات المستلمة. تحقق من الرمز وحاول مجددًا."
          }
        }
      }
    },
