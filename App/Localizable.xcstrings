    "1 · Install the gateway": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · ثبّت البوابة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · Gateway installieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · Instala el gateway"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · Installer la passerelle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · Installa il gateway"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · 安装网关"
          }
        }
      }
    },
    "2 · Create an API key": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "2 · أنشئ مفتاح API"
          }
        },
        "de": {
