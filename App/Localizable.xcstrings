    "Credentials for this server are missing on the TV. Pair it again from your iPhone, iPad or Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات اعتماد هذا الخادم مفقودة على التلفاز. أعد الإقران من iPhone أو iPad أو Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zugangsdaten dieses Servers fehlen auf dem TV. Kopple ihn erneut von iPhone, iPad oder Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan las credenciales de este servidor en el TV. Vuelve a emparejarlo desde tu iPhone, iPad o Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants de ce serveur manquent sur la TV. Refaites le jumelage depuis votre iPhone, iPad ou Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulla TV mancano le credenziali di questo server. Ripeti l’abbinamento da iPhone, iPad o Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV 上缺少此服务器的凭据。请从 iPhone、iPad 或 Mac 重新配对。"
          }
        }
      }
    },
    "Credentials missing from the Keychain. Use Edit to enter them again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات الاعتماد غير موجودة في سلسلة المفاتيح. استخدم «تعديل» لإدخالها مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten fehlen im Schlüsselbund. Gib sie über „Bearbeiten“ erneut ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan las credenciales en el llavero. Usa Editar para introducirlas de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiants absents du trousseau. Utilisez Modifier pour les saisir à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenziali assenti dal portachiavi. Usa Modifica per inserirle di nuovo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钥匙串中缺少凭据。请使用“编辑”重新输入。"
          }
        }
      }
    },
    "Credentials missing on this Mac": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات الاعتماد مفقودة على هذا الـ Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten fehlen auf diesem Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan las credenciales en este Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiants manquants sur ce Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenziali mancanti su questo Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 上缺少凭据"
          }
        }
      }
    },
    "Credentials not available yet. After an iCloud restore they arrive through iCloud Keychain within a minute; try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات الاعتماد غير متاحة بعد. بعد الاستعادة من iCloud تصل عبر سلسلة مفاتيح iCloud خلال دقيقة؛ أعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten noch nicht verfügbar. Nach einer iCloud-Wiederherstellung kommen sie innerhalb einer Minute über den iCloud-Schlüsselbund; bitte erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenciales aún no disponibles. Tras una restauración de iCloud llegan por el Llavero de iCloud en un minuto; reintenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiants pas encore disponibles. Après une restauration iCloud ils arrivent par le trousseau iCloud en une minute ; réessayez."
