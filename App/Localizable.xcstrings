    "Add your Unraid server from the preferences; its shares then appear in the Finder sidebar.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il tuo server Unraid dalle preferenze: le sue share compariranno nella barra laterale del Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu servidor Unraid desde las preferencias; sus recursos compartidos aparecerán en la barra lateral del Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre serveur Unraid depuis les préférences ; ses partages apparaîtront dans la barre latérale du Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinen Unraid-Server in den Einstellungen hinzu; seine Freigaben erscheinen dann in der Finder-Seitenleiste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在偏好设置中添加你的 Unraid 服务器，其共享随后会显示在“访达”边栏中。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف خادم Unraid من التفضيلات؛ ستظهر مشاركاته في الشريط الجانبي لـ Finder."
          }
        }
      }
    },
