    "Every server you add becomes its own location in the Finder sidebar. Right-click a server to remove it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni server aggiunto diventa una posizione nella barra laterale del Finder. Fai clic destro su un server per rimuoverlo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada servidor que añades se convierte en una ubicación en la barra lateral del Finder. Haz clic derecho en un servidor para eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque serveur ajouté devient un emplacement dans la barre latérale du Finder. Cliquez avec le bouton droit sur un serveur pour le supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder hinzugefügte Server wird zu einem Ort in der Finder-Seitenleiste. Klicke mit der rechten Maustaste auf einen Server, um ihn zu entfernen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加的每个服务器都会成为“访达”边栏中的一个位置。右键点按服务器可将其移除。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصبح كل خادم تضيفه موقعًا في الشريط الجانبي لـ Finder. انقر بزر الماوس الأيمن على خادم لإزالته."
          }
        }
      }
    },
