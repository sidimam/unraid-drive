    "Shares are read-only or the gateway runs with READ_ONLY=true. Check the volume access mode in the container settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجلدات المشتركة للقراءة فقط أو تعمل البوابة بـ READ_ONLY=true. تحقق من وضع الوصول للمجلدات في إعدادات الحاوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigaben sind schreibgeschützt oder das Gateway läuft mit READ_ONLY=true. Prüfe den Zugriffsmodus der Volumes in den Container-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recursos compartidos son de solo lectura o el gateway usa READ_ONLY=true. Revisa el modo de acceso de los volúmenes en la configuración del contenedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les partages sont en lecture seule ou la passerelle tourne avec READ_ONLY=true. Vérifiez le mode d’accès des volumes dans les réglages du conteneur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le share sono in sola lettura o il gateway ha READ_ONLY=true. Controlla la modalità di accesso dei volumi nelle impostazioni del container."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享为只读，或网关以 READ_ONLY=true 运行。请检查容器设置中卷的访问模式。"
          }
        }
      }
    },
