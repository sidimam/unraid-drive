          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir notificaciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les notifications"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le notifiche"
          }
        },
        "zh-Hans": {
