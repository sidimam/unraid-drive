{
  "sourceLanguage": "en",
  "strings": {
    " · gateway read-only": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " · البوابة للقراءة فقط"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · Gateway schreibgeschützt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " · gateway de solo lectura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " · passerelle en lecture seule"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " · gateway in sola lettura"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · 网关为只读"
          }
        }
      }
    },
    "%1$@key %2$@ · %3$@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@المفتاح %2$@ · %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@Schlüssel %2$@ · %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@clave %2$@ · %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@clé %2$@ · %3$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@chiave %2$@ · %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@密钥 %2$@ · %3$@"
          }
        }
      }
    },
    "%@ is reachable (gateway %@) and the key is accepted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ متاح (البوابة %@) والمفتاح مقبول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist erreichbar (Gateway %@) und der Schlüssel wird akzeptiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ responde (gateway %@) y la clave es aceptada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est joignable (passerelle %@) et la clé est acceptée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è raggiungibile (gateway %@) e la chiave è accettata."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可连接（网关 %@），密钥已被接受。"
          }
        }
      }
    },
    "%@ is reachable again": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ متاح مجددًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist wieder erreichbar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuelve a estar disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est de nouveau joignable"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è di nuovo raggiungibile"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已恢复连接"
          }
        }
      }
    },
