    "No backup found yet. Turning sync on saves this device's servers for the others.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على نسخة احتياطية بعد. تفعيل المزامنة يحفظ خوادم هذا الجهاز للأجهزة الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Backup gefunden. Mit der Synchronisierung werden die Server dieses Geräts für die anderen gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay copia. Al activar la sincronización, los servidores de este dispositivo se guardan para los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune sauvegarde pour l’instant. Activer la synchronisation enregistre les serveurs de cet appareil pour les autres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun backup trovato. Attivando la sincronizzazione, i server di questo dispositivo vengono salvati per gli altri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未找到备份。开启同步会为其他设备保存此设备上的服务器。"
          }
        }
      }
    },
