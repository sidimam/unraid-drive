    "Every server keeps the shares chosen on your other device; change them any time from the server's page, Shares to show.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni server mantiene le share scelte sull'altro dispositivo; puoi cambiarle in qualsiasi momento dalla pagina del server, Share da mostrare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada servidor conserva las carpetas elegidas en tu otro dispositivo; cámbialas cuando quieras desde la página del servidor, Carpetas a mostrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque serveur garde les partages choisis sur votre autre appareil ; modifiez-les à tout moment depuis la page du serveur, Partages à afficher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Server behält die auf dem anderen Gerät gewählten Freigaben; ändern Sie sie jederzeit auf der Serverseite unter Anzuzeigende Freigaben."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个服务器都保留你在其他设备上选择的共享；可随时在服务器页面的“显示的共享”中更改。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ كل خادم بالمشاركات المختارة على جهازك الآخر؛ غيّرها في أي وقت من صفحة الخادم، المشاركات المعروضة."
          }
        }
      }
    },
    "Every server you add becomes its own location in the Files app. Swipe left on a server to remove it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل خادم تضيفه يصبح موقعًا مستقلًا في تطبيق الملفات. اسحب على الخادم لإزالته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder hinzugefügte Server wird zu einem eigenen Ort in der Dateien-App. Wische auf einem Server nach links, um ihn zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada servidor que añades se convierte en una ubicación en la app Archivos. Desliza a la izquierda sobre un servidor para eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque serveur ajouté devient un emplacement dans l’app Fichiers. Balayez un serveur vers la gauche pour le supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni server aggiunto diventa una posizione nell’app File. Scorri a sinistra su un server per rimuoverlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个添加的服务器都会成为“文件”应用中的一个位置。在服务器上向左轻扫即可移除。"
          }
        }
      }
    },
    "Every server you add becomes its own location in the Finder sidebar. Right-click a server to remove it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصبح كل خادم تضيفه موقعًا في الشريط الجانبي لـ Finder. انقر بزر الماوس الأيمن على خادم لإزالته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder hinzugefügte Server wird zu einem Ort in der Finder-Seitenleiste. Klicke mit der rechten Maustaste auf einen Server, um ihn zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada servidor que añades se convierte en una ubicación en la barra lateral del Finder. Haz clic derecho en un servidor para eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque serveur ajouté devient un emplacement dans la barre latérale du Finder. Cliquez avec le bouton droit sur un serveur pour le supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni server aggiunto diventa una posizione nella barra laterale del Finder. Fai clic destro su un server per rimuoverlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加的每个服务器都会成为“访达”边栏中的一个位置。右键点按服务器可将其移除。"
          }
        }
      }
    },
    "Everything is fine": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء على ما يرام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in Ordnung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en orden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout va bien"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto a posto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切正常"
          }
        }
      }
    },
    "External apps stream through a signed gateway link that carries no headers: behind Cloudflare Access the /media path must be excluded from the Access policy.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم التطبيقات الخارجية رابطًا موقّعًا من البوابة بلا ترويسات: خلف Cloudflare Access يجب استثناء المسار /media من سياسة Access."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Externe Apps erhalten einen signierten Gateway-Link ohne Header: hinter Cloudflare Access muss der Pfad /media von der Access-Richtlinie ausgenommen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps externas reciben un enlace firmado del gateway sin cabeceras: tras Cloudflare Access hay que excluir la ruta /media de la política de Access."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps externes reçoivent un lien signé de la passerelle sans en-têtes : derrière Cloudflare Access, le chemin /media doit être exclu de la politique Access."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app esterne ricevono un link firmato del gateway senza header: dietro Cloudflare Access il percorso /media va escluso dalla policy di Access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外部应用通过不带请求头的网关签名链接播放：若使用 Cloudflare Access，需将 /media 路径排除在 Access 策略之外。"
          }
        }
      }
    },
