            "value": "Erfordert unraid-gateway 0.6 oder neuer auf dem Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere unraid-gateway 0.6 o posterior en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite unraid-gateway 0.6 ou ultérieur sur le serveur."
          }
        },
