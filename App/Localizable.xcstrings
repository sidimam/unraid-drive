    "Secrets are never shown back. Paste the API key again (and the service token, if any) to save.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُعرض الأسرار مجددًا. الصق مفتاح API مرة أخرى (ورمز الخدمة إن وجد) للحفظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheimnisse werden nie erneut angezeigt. Füge den API-Schlüssel (und ggf. das Service Token) erneut ein, um zu sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los secretos nunca se vuelven a mostrar. Pega de nuevo la clave API (y el service token, si lo hay) para guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les secrets ne sont jamais réaffichés. Collez à nouveau la clé API (et le service token, le cas échéant) pour enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segreti non vengono mai rimostrati. Incolla di nuovo la chiave API (e il service token, se c’è) per salvare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥不会再次显示。请重新粘贴 API 密钥（以及 Service Token，如有）以保存。"
          }
        }
      }
    },
