{
  "sourceLanguage": "en",
  "strings": {
    " · gateway read-only": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " · البوابة للقراءة فقط"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · Gateway schreibgeschützt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " · gateway de solo lectura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " · passerelle en lecture seule"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " · gateway in sola lettura"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · 网关为只读"
          }
        }
      }
    },
    "%1$@key %2$@ · %3$@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@المفتاح %2$@ · %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@Schlüssel %2$@ · %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@clave %2$@ · %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@clé %2$@ · %3$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@chiave %2$@ · %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@密钥 %2$@ · %3$@"
          }
        }
      }
    },
    "%lld%%": {},
    "1 · Install the gateway": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · ثبّت البوابة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · Gateway installieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · Instala el gateway"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · Installer la passerelle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · Installa il gateway"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · 安装网关"
          }
        }
      }
    },
    "2 · Create an API key": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "2 · أنشئ مفتاح API"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2 · API-Schlüssel erstellen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2 · Crea una clave API"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2 · Créer une clé API"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "2 · Crea una chiave API"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 · 创建 API 密钥"
          }
        }
      }
    },
    "3 · Reach it from outside": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "3 · الوصول من الخارج"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3 · Von außen erreichen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3 · Accede desde fuera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 · Y accéder depuis l’extérieur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3 · Raggiungilo da fuori casa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3 · 从外网访问"
          }
        }
      }
    },
    "4 · Add the server": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "4 · أضف الخادم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "4 · Server hinzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "4 · Añade el servidor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4 · Ajouter le serveur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "4 · Aggiungi il server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4 · 添加服务器"
          }
        }
      }
    },
    "A configuration saved by Unraid Drive was found in your iCloud account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على إعدادات حفظها Unraid Drive في حساب iCloud الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem iCloud-Account wurde eine von Unraid Drive gespeicherte Konfiguration gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró una configuración guardada por Unraid Drive en tu cuenta de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une configuration enregistrée par Unraid Drive a été trouvée dans votre compte iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel tuo account iCloud è presente una configurazione salvata da Unraid Drive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 iCloud 账户中找到了 Unraid Drive 保存的配置。"
          }
        }
      }
    },
    "A configuration saved by this app is present in your iCloud account. Restoring turns sync on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجد إعدادات حفظها هذا التطبيق في حساب iCloud الخاص بك. الاستعادة تُفعّل المزامنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem iCloud-Account liegt eine von dieser App gespeicherte Konfiguration. Wiederherstellen schaltet die Synchronisierung ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una configuración guardada por esta app en tu cuenta de iCloud. Restaurar activa la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une configuration enregistrée par cette app est présente dans votre compte iCloud. La restauration active la synchronisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel tuo account iCloud è presente una configurazione salvata da questa app. Il ripristino attiva la sincronizzazione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iCloud 账户中存在本应用保存的配置。恢复后会开启同步。"
          }
        }
      }
    },
