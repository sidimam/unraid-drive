    "Your Unraid user has no access to any mounted share": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يملك مستخدم Unraid الخاص بك صلاحية الوصول إلى أي مجلد مشترك مثبّت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Unraid-Benutzer hat auf keine eingebundene Freigabe Zugriff"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu usuario de Unraid no tiene acceso a ningún recurso montado"
          }
        },
        "fr": {
