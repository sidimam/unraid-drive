    },
    "A configuration saved by Unraid Drive on another device was found. Restoring turns sync on; the secrets arrive through iCloud Keychain and this device is registered on each gateway again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stata trovata una configurazione salvata da Unraid Drive su un altro dispositivo. Il ripristino attiva la sincronizzazione; i segreti arrivano dal Portachiavi iCloud e questo dispositivo viene registrato di nuovo su ogni gateway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró una configuración guardada por Unraid Drive en otro dispositivo. Restaurar activa la sincronización; los secretos llegan por el llavero de iCloud y este dispositivo vuelve a registrarse en cada gateway."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une configuration enregistrée par Unraid Drive sur un autre appareil a été trouvée. La restauration active la synchronisation ; les secrets arrivent par le trousseau iCloud et cet appareil est réenregistré sur chaque passerelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine von Unraid Drive auf einem anderen Gerät gespeicherte Konfiguration wurde gefunden. Die Wiederherstellung schaltet die Synchronisierung ein; die Geheimnisse kommen über den iCloud-Schlüsselbund und dieses Gerät wird bei jedem Gateway erneut registriert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到了 Unraid Drive 在另一台设备上保存的配置。恢复会开启同步；密钥通过 iCloud 钥匙串送达，本设备会重新在每个网关上注册。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على إعدادات حفظها Unraid Drive على جهاز آخر. الاستعادة تفعّل المزامنة؛ تصل الأسرار عبر سلسلة مفاتيح iCloud ويُعاد تسجيل هذا الجهاز على كل بوابة."
          }
        }
      }
    },
    "A configuration saved by Unraid Drive was found in your iCloud account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على إعدادات حفظها Unraid Drive في حساب iCloud الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem iCloud-Account wurde eine von Unraid Drive gespeicherte Konfiguration gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró una configuración guardada por Unraid Drive en tu cuenta de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une configuration enregistrée par Unraid Drive a été trouvée dans votre compte iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel tuo account iCloud è presente una configurazione salvata da Unraid Drive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 iCloud 账户中找到了 Unraid Drive 保存的配置。"
          }
        }
      }
    },
    "A configuration saved by this app is present in your iCloud account. Restoring turns sync on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجد إعدادات حفظها هذا التطبيق في حساب iCloud الخاص بك. الاستعادة تُفعّل المزامنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem iCloud-Account liegt eine von dieser App gespeicherte Konfiguration. Wiederherstellen schaltet die Synchronisierung ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una configuración guardada por esta app en tu cuenta de iCloud. Restaurar activa la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une configuration enregistrée par cette app est présente dans votre compte iCloud. La restauration active la synchronisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel tuo account iCloud è presente una configurazione salvata da questa app. Il ripristino attiva la sincronizzazione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iCloud 账户中存在本应用保存的配置。恢复后会开启同步。"
          }
        }
      }
    },
