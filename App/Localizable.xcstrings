            "value": "3 · Raggiungilo da fuori casa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3 · 从外网访问"
          }
        }
      }
    },
    "4 · Add the server": {
      "localizations": {
        "ar": {
          "stringUnit": {
