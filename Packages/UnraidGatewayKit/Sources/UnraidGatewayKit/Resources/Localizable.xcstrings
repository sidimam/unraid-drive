{
  "sourceLanguage": "en",
  "strings": {
    "A web page answered instead of the file (%@): usually a Cloudflare Access login. Check the service token in the server's settings.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha risposto una pagina web invece del file (%@): di solito è il login di Cloudflare Access. Controlla il service token nelle impostazioni del server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respondió una página web en lugar del archivo (%@): normalmente el inicio de sesión de Cloudflare Access. Revisa el token de servicio en los ajustes del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page web a répondu à la place du fichier (%@) : en général la connexion Cloudflare Access. Vérifiez le jeton de service dans les réglages du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt der Datei hat eine Webseite geantwortet (%@): meist die Cloudflare-Access-Anmeldung. Prüfen Sie das Service-Token in den Servereinstellungen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回的是网页而不是文件（%@）：通常是 Cloudflare Access 登录页。请检查服务器设置中的服务令牌。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجابت صفحة ويب بدل الملف (%@): غالبًا تسجيل دخول Cloudflare Access. تحقّق من رمز الخدمة في إعدادات الخادم."
          }
        }
      }
    },
    "Cannot reach the gateway: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الوصول إلى البوابة: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway nicht erreichbar: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede alcanzar el gateway: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre la passerelle : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il gateway: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接网关：%@"
          }
        }
      }
    },
    "Cloudflare Access is blocking the request. Add this server with Connection: Cloudflare Access and a valid service token, and make sure the Access policy uses the Service Auth action.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحجب Cloudflare Access الطلب. أضف هذا الخادم بوضع الاتصال Cloudflare Access ورمز خدمة صالح، وتأكد من أن سياسة Access تستخدم الإجراء Service Auth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Access blockiert die Anfrage. Füge diesen Server mit Verbindung: Cloudflare Access und einem gültigen Service Token hinzu und stelle sicher, dass die Access-Richtlinie die Aktion Service Auth verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Access está bloqueando la petición. Añade este servidor con Conexión: Cloudflare Access y un service token válido, y asegúrate de que la política de Access use la acción Service Auth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Access bloque la requête. Ajoutez ce serveur avec Connexion : Cloudflare Access et un service token valide, et vérifiez que la politique Access utilise l’action Service Auth."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Access sta bloccando la richiesta. Aggiungi questo server con Connessione: Cloudflare Access e un service token valido, e verifica che la policy di Access usi l’azione Service Auth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Access 阻止了请求。请以“连接方式：Cloudflare Access”和有效的 Service Token 添加此服务器，并确保 Access 策略使用 Service Auth 操作。"
          }
        }
      }
    },
    "Not found.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير موجود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encontrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Introuvable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non trovato."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到。"
          }
        }
      }
    },
    "Server error %lld: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ في الخادم %lld: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverfehler %lld: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error del servidor %lld: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur du serveur %lld : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errore del server %lld: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器错误 %lld：%@"
          }
        }
      }
    },
    "The API key, or the Unraid username and password, were rejected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض مفتاح API أو اسم مستخدم Unraid وكلمة المرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der API-Schlüssel oder Unraid-Benutzername und -Passwort wurden abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave API, o el usuario y la contraseña de Unraid, fueron rechazados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé API, ou le nom d’utilisateur et le mot de passe Unraid, ont été refusés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave API, oppure utente e password Unraid, sono stati rifiutati."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥或 Unraid 用户名和密码被拒绝。"
          }
        }
      }
    },
    "The file changed on the server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر الملف على الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wurde auf dem Server geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo cambió en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a changé sur le serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è cambiato sul server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在服务器上已更改。"
          }
        }
      }
    },
    "The gateway answered %lld: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gateway ha risposto %lld: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gateway respondió %lld: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La passerelle a répondu %lld : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway antwortete %lld: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关返回 %lld：%@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجابت البوابة %lld: %@"
          }
        }
      }
    },
    "The gateway answered with JSON instead of the file: update unraid-gateway.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gateway ha risposto con JSON invece del file: aggiorna unraid-gateway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gateway respondió con JSON en lugar del archivo: actualiza unraid-gateway."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La passerelle a répondu en JSON au lieu du fichier : mettez à jour unraid-gateway."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway antwortete mit JSON statt der Datei: unraid-gateway aktualisieren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关返回了 JSON 而不是文件：请更新 unraid-gateway。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجابت البوابة بـ JSON بدل الملف: حدّث unraid-gateway."
          }
        }
      }
    },
    "The gateway did not answer.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gateway non ha risposto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gateway no respondió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La passerelle n'a pas répondu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway hat nicht geantwortet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关没有响应。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تستجب البوابة."
          }
        }
      }
    },
    "The server URL is not valid.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان الخادم غير صالح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Server-URL ist ungültig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL del servidor no es válida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’URL du serveur n’est pas valide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’URL del server non è valido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器 URL 无效。"
          }
        }
      }
    },
    "The server answered with a web page instead of data (%@). A login portal or proxy is intercepting the request: check the gateway URL and the connection mode.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجاب الخادم بصفحة ويب بدلًا من البيانات (%@). بوابة تسجيل دخول أو وكيل يعترض الطلب: تحقق من عنوان البوابة ووضع الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat mit einer Webseite statt mit Daten geantwortet (%@). Ein Anmeldeportal oder Proxy fängt die Anfrage ab: Prüfe Gateway-URL und Verbindungsmodus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor respondió con una página web en lugar de datos (%@). Un portal de inicio de sesión o un proxy intercepta la petición: revisa la URL del gateway y el modo de conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu par une page web au lieu de données (%@). Un portail de connexion ou un proxy intercepte la requête : vérifiez l’URL de la passerelle et le mode de connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha risposto con una pagina web invece dei dati (%@). Un portale di login o un proxy intercetta la richiesta: controlla l’URL del gateway e la modalità di connessione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回了网页而非数据（%@）。登录门户或代理拦截了请求：请检查网关 URL 和连接方式。"
          }
        }
      }
    },
    "This device is not registered on the gateway. Open the server, choose Edit server or credentials and connect again to register it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجهاز غير مسجّل في البوابة. افتح الخادم واختر تعديل الخادم أو بيانات الاعتماد ثم اتصل مرة أخرى لتسجيله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist am Gateway nicht registriert. Öffne den Server, wähle Server oder Zugangsdaten bearbeiten und verbinde dich erneut, um es zu registrieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no está registrado en el gateway. Abre el servidor, elige Editar servidor o credenciales y conecta de nuevo para registrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’est pas enregistré sur la passerelle. Ouvrez le serveur, choisissez Modifier le serveur ou les identifiants et reconnectez-vous pour l’enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non è registrato sul gateway. Apri il server, scegli Modifica server o credenziali e collegati di nuovo per registrarlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备未在网关上注册。打开服务器，选择“编辑服务器或凭据”并重新连接以注册它。"
          }
        }
      }
    },
    "This device was removed from the gateway. Open the server, choose Edit server or credentials and connect again to register it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إزالة هذا الجهاز من البوابة. افتح الخادم واختر تعديل الخادم أو بيانات الاعتماد ثم اتصل مرة أخرى لتسجيله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät wurde vom Gateway entfernt. Öffne den Server, wähle Server oder Zugangsdaten bearbeiten und verbinde dich erneut, um es zu registrieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo se eliminó del gateway. Abre el servidor, elige Editar servidor o credenciales y conecta de nuevo para registrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil a été retiré de la passerelle. Ouvrez le serveur, choisissez Modifier le serveur ou les identifiants et reconnectez-vous pour l’enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo è stato rimosso dal gateway. Apri il server, scegli Modifica server o credenziali e collegati di nuovo per registrarlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备已从网关移除。打开服务器，选择“编辑服务器或凭据”并重新连接以注册它。"
          }
        }
      }
    },
    "This gateway requires an Unraid username and password in addition to the API key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب هذه البوابة اسم مستخدم وكلمة مرور Unraid إضافة إلى مفتاح API."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gateway verlangt zusätzlich zum API-Schlüssel einen Unraid-Benutzernamen und ein Passwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este gateway requiere usuario y contraseña de Unraid además de la clave API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette passerelle exige un utilisateur et un mot de passe Unraid en plus de la clé API."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gateway richiede utente e password Unraid oltre alla chiave API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网关除 API 密钥外还需要 Unraid 用户名和密码。"
          }
        }
      }
    },
    "Too many failed attempts. Try again in a few minutes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات فاشلة كثيرة. حاول مجددًا بعد بضع دقائق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele fehlgeschlagene Versuche. Versuche es in ein paar Minuten erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos fallidos. Inténtalo de nuevo en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives échouées. Réessayez dans quelques minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi falliti. Riprova tra qualche minuto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败次数过多。请几分钟后重试。"
          }
        }
      }
    },
    "Unexpected response: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استجابة غير متوقعة: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unerwartete Antwort: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta inesperada: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse inattendue : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risposta inattesa: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "意外的响应：%@"
          }
        }
      }
    }
  },
  "version": "1.0"
}